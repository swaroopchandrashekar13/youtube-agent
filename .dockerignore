# Never ship secrets, local state or build noise in the image (CLAUDE.md rule 2).
.git
.github
.env
.env.*
!.env.example
config/*.json
!config/credentials.example.json
config/*.key
config/*.pem
*.key
*.pem
node_modules
data
logs
uploads
temp
tmp
coverage
*.log
*.mp4
*.mp3
*.wav

# Not needed at runtime
test
test.js
docs
assets
reports
examples
scripts/docs
scripts/growth
.claude
